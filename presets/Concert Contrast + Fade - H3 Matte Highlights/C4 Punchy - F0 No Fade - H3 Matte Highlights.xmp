   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C4 Punchy - F0 No Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">403 C4 Punchy - F0 No Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Punchy (S-curve 28). Blacks: No Fade (black lifted to 0). Highlights: Matte Highlights (white at 225). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
