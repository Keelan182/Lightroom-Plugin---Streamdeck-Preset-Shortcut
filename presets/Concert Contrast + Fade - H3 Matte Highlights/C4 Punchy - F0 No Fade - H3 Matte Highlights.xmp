    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>32, 12</rdf:li>
     <rdf:li>64, 36</rdf:li>
     <rdf:li>128, 125</rdf:li>
     <rdf:li>192, 201</rdf:li>
     <rdf:li>224, 217</rdf:li>
     <rdf:li>255, 225</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
