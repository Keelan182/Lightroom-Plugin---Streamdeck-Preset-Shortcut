   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C1 Soft - F2 Medium Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C1 Soft - F2 Medium Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">123 C1 Soft - F2 Medium Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Soft (S-curve 8). Blacks: Medium Fade (black lifted to 24). Highlights: Matte Highlights (white at 225). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
   <crs:ToneCurvePV2012>
    <rdf:Seq>
     <rdf:li>0, 24</rdf:li>
     <rdf:li>32, 43</rdf:li>
     <rdf:li>64, 67</rdf:li>
     <rdf:li>128, 127</rdf:li>
     <rdf:li>192, 186</rdf:li>
     <rdf:li>224, 208</rdf:li>
     <rdf:li>255, 225</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
  </rdf:Description>
