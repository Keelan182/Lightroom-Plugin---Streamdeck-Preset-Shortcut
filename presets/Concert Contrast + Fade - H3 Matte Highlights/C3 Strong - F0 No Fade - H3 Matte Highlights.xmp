   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C3 Strong - F0 No Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C3 Strong - F0 No Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">303 C3 Strong - F0 No Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H3 Matte Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Strong (S-curve 20). Blacks: No Fade (black lifted to 0). Highlights: Matte Highlights (white at 225). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
