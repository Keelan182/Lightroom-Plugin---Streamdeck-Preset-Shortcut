    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>32, 18</rdf:li>
     <rdf:li>64, 44</rdf:li>
     <rdf:li>128, 124</rdf:li>
     <rdf:li>192, 195</rdf:li>
     <rdf:li>224, 213</rdf:li>
     <rdf:li>255, 225</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
