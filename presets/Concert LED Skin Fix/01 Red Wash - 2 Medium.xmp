   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Red LED light. Pulls red out of the midtones/highlights and restores green and blue so skin reads warm-neutral instead of crimson.</rdf:li>
    </rdf:Alt>
   </crs:Description>
