   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C3 Strong - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C3 Strong - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">311 C3 Strong - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Strong (S-curve 20). Blacks: Light Fade (black lifted to 12). Highlights: Soft Highlights (white at 245). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
   <crs:ToneCurvePV2012>
    <rdf:Seq>
     <rdf:li>0, 12</rdf:li>
     <rdf:li>32, 27</rdf:li>
     <rdf:li>64, 51</rdf:li>
     <rdf:li>128, 128</rdf:li>
     <rdf:li>192, 206</rdf:li>
     <rdf:li>224, 230</rdf:li>
     <rdf:li>255, 245</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
