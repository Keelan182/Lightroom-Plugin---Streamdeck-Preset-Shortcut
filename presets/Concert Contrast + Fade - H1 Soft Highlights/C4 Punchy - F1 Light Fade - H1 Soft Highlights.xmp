   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C4 Punchy - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C4 Punchy - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">411 C4 Punchy - F1 Light Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H1 Soft Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Punchy (S-curve 28). Blacks: Light Fade (black lifted to 12). Highlights: Soft Highlights (white at 245). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
   <crs:ToneCurvePV2012>
    <rdf:Seq>
     <rdf:li>0, 12</rdf:li>
     <rdf:li>32, 22</rdf:li>
     <rdf:li>64, 44</rdf:li>
     <rdf:li>128, 128</rdf:li>
     <rdf:li>192, 214</rdf:li>
     <rdf:li>224, 235</rdf:li>
     <rdf:li>255, 245</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
  </rdf:Description>
