   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C1 Soft - F3 Heavy Fade - H2 Medium Highlights</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C1 Soft - F3 Heavy Fade - H2 Medium Highlights</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">132 C1 Soft - F3 Heavy Fade - H2 Medium Highlights</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade - H2 Medium Highlights</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Soft (S-curve 8). Blacks: Heavy Fade (black lifted to 40). Highlights: Medium Highlights (white at 235). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
   <crs:ToneCurvePV2012>
    <rdf:Seq>
     <rdf:li>0, 40</rdf:li>
     <rdf:li>32, 55</rdf:li>
     <rdf:li>64, 75</rdf:li>
     <rdf:li>128, 130</rdf:li>
     <rdf:li>192, 191</rdf:li>
     <rdf:li>224, 215</rdf:li>
     <rdf:li>255, 235</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>
  </rdf:Description>
