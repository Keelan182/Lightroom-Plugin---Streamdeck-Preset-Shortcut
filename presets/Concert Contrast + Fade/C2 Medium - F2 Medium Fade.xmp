   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C2 Medium - F2 Medium Fade</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">C2 Medium - F2 Medium Fade</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">22 C2 Medium - F2 Medium Fade</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Concert Contrast + Fade</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Master luminance curve only. Contrast: Medium (S-curve 14). Blacks: Medium Fade (black lifted to 24). Colour channel curves untouched.</rdf:li>
    </rdf:Alt>
   </crs:Description>
