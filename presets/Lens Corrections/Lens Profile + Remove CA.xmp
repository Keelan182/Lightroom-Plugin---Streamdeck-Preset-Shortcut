   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Lens Profile + Remove CA</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Lens Profile + Remove CA</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">01 Lens Profile + Remove CA</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Lens Corrections</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Turns on lens profile corrections with Setup = Auto (profile chosen from each photo's lens metadata) and turns on Remove Chromatic Aberration. Changes nothing else.</rdf:li>
    </rdf:Alt>
   </crs:Description>
