   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color slide film approximation. ISO 200. Grainier, warmer Kodachrome; good for available-light colour. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
