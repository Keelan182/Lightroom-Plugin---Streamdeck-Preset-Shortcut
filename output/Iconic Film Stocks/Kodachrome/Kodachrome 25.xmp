   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color slide film approximation. ISO 25. Best on daylight scenes with strong primaries. Lower Amount for skin-heavy portraits. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
