   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CineStill 800T</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CineStill 800T</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CineStill 800T</rdf:li>
