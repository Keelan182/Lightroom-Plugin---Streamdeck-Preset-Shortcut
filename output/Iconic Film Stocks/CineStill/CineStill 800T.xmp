    <rdf:Alt>
     <rdf:li xml:lang="x-default">CineStill</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color negative film approximation. ISO 800. Night street, neon and tungsten scenes. Leave white balance as shot; the preset adds the teal cast through grading, not WB. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
