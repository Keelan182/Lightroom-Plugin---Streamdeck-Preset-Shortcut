   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color negative film approximation. ISO 400. Bright, pastel weddings/portraits. Works best on slightly overexposed images. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
