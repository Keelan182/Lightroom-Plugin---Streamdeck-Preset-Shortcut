   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Kodak Gold - Color negative film approximation. ISO 200. Summer, family and travel snapshots. Already warm: don't add warmth with WB on top. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
