   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Lomochrome Purple - Specialty film approximation. Foliage-heavy scenes. Highly image-dependent; dial Amount to taste. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
