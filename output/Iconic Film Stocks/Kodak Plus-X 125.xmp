   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Kodak Plus-X - Black &amp; white film approximation. ISO 125. Balanced vintage B&amp;W; portraits and everyday. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
