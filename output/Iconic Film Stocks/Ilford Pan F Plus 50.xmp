   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ilford Pan F Plus 50</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ilford Pan F Plus 50</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">20 Ilford Pan F Plus 50</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Iconic Film Stocks</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ilford Pan F Plus - Black &amp; white film approximation. ISO 50. Bright light only; very crisp. Lower Amount if blacks block up. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
