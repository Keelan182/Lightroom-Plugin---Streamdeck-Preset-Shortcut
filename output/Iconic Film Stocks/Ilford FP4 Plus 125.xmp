   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ilford FP4 Plus - Black &amp; white film approximation. ISO 125. Landscape and studio; smooth, detailed. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
