   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color slide film approximation. ISO 100. Clean, cool slide look; nice for snow, water and architecture. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
