   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Kodak Portra - Color negative film approximation. ISO 800. Low-light/event Portra; warmer highlights. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
