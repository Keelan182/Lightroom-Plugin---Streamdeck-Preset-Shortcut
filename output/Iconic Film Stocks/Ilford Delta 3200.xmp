   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ilford Delta 3200 - Black &amp; white film approximation. ISO 3200. Concerts, night, moody low light. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
