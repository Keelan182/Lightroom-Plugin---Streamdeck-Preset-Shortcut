   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Kodachrome - Color slide film approximation. ISO 64. The 'National Geographic' variant. Great for travel and street colour. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
