    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Color negative film approximation. ISO 400. Most versatile Portra. Overexpose/brighten before applying for the classic airy look. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
   </crs:Description>
