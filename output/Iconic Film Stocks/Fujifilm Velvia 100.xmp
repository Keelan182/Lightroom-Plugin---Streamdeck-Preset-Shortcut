   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Fujifilm Velvia - Color slide film approximation. ISO 100. Slightly more forgiving Velvia; still lower Amount for people. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
