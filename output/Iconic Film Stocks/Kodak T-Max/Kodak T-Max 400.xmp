   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Black &amp; white film approximation. ISO 400. Faster T-grain; cleaner than Tri-X at the same speed. Visual approximation built from Lightroom sliders; not an exact reproduction.</rdf:li>
    </rdf:Alt>
